{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kudopixe-website-test",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kudopixel-website-test","database_id": "4441c812-d60b-4292-a27c-d31ce7a27aec",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "kudopixel-website-test","preview_bucket_name": "kudopixel-website-test",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
